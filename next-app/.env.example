DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=streetlight_web
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=streetlight_ops
SESSION_TTL_HOURS=12
# Set to true only when serving HTTPS in production.
COOKIE_SECURE=false
# Defaults to the local no-auth MongoDB server and database shown here.
# An explicitly configured URI/database override these local defaults.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=streetlight_ops
